# Obital environment template. Copy to `.env` at the repository root.
#
# Only DEEPSEEK_API_KEY and UNLOCK_TOKEN_SECRET must be set for a local run;
# every other variable has the default shown here. Values are read via
# os.getenv at import time, so restart the process after changing them.
#
# .env is gitignored. Never commit real keys, and never reuse a production
# UNLOCK_TOKEN_SECRET or ACCOUNT_SYNC_PASSPHRASE locally.

# ----------------------------------------------------------------------------
# LLM provider (required)
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-v4-flash
# Point at any OpenAI-compatible endpoint (OpenAI, a local server, a proxy).
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Reasoning controls. Thinking is off by default because it costs latency.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high

# ----------------------------------------------------------------------------
# Web search (optional). Leave blank to disable the web-search tool.
# ----------------------------------------------------------------------------
EXA_API_KEY=

# ----------------------------------------------------------------------------
# Pipeline and storage locations
# ----------------------------------------------------------------------------
# Repository root. Account artifacts resolve to <base>/engine/accounts/<id>/.
PIPELINE_BASE_DIR=.
GRAPH_STORAGE_DIR=./data/graph_db

# ----------------------------------------------------------------------------
# Embeddings
# ----------------------------------------------------------------------------
# client: the browser generates MiniLM embeddings via WebGPU/WASM.
# server: requires sentence-transformers installed locally.
EMBEDDING_MODE=client
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_ALLOW_HASH_FALLBACK=false
# Override the sentence-transformers/HuggingFace cache directory.
OBITAL_MODEL_CACHE_DIR=

# Optional external vector backend. Blank keeps the local index.
VECTOR_BACKEND_URL=
VECTOR_BACKEND_API_KEY=
VECTOR_BACKEND_TIMEOUT_SEC=20

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local SQLite mode: set LOCAL_DATABASE_URL and leave DATABASE_URL unset.
# LOCAL_DATABASE_URL=sqlite:///backend/data/obital.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/obital
# Separate URL for Alembic when migrations need a direct (non-pooled) connection.
DATABASE_MIGRATION_URL=
DB_AUTO_CREATE_SCHEMA=true
DB_HEALTH_VERBOSE_ERRORS=false
# Force cloud/Postgres storage even when a local URL is present.
OBITAL_FORCE_CLOUD_DB=

# ----------------------------------------------------------------------------
# Sync
# ----------------------------------------------------------------------------
# 0 disables the background scheduler; sync then runs only on request.
SYNC_INTERVAL_MINUTES=0
# Passphrase used by the cloud sync scripts under scripts/sync/. Treat as a
# credential: it derives the key that unwraps synced account data.
ACCOUNT_SYNC_PASSPHRASE=

# ----------------------------------------------------------------------------
# Authentication and account unlock
# ----------------------------------------------------------------------------
UNLOCK_TOKEN_SECRET=change-me
UNLOCK_TOKEN_TTL_MINUTES=30
UNLOCK_MAX_FAILED_ATTEMPTS=5
UNLOCK_LOCKOUT_MINUTES=15
# Per-token rate limiting, distinct from the per-account lockout above.
UNLOCK_TOKEN_MAX_FAILED_ATTEMPTS=20
UNLOCK_TOKEN_FAILURE_WINDOW_SECONDS=60
UNLOCK_TOKEN_LOCKOUT_SECONDS=30
# Sign-in PIN lockout.
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
# Skip auth entirely for a single-user local install. Never enable in cloud.
OBITAL_LOCAL_SINGLE_USER=

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OBITAL_MAX_UPLOAD_MB=20
OBITAL_LOG_LEVEL=INFO
OBITAL_LOG_FILE=backend/data/logs/backend.log
# Base URL the Textual TUI uses to reach the backend.
OBITAL_BACKEND_URL=http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# Feature behaviour
# ----------------------------------------------------------------------------
# Allow the tutor to answer without grounding in the user's own documents.
OBITAL_ALLOW_ONLINE_TUTOR=
OBITAL_LESSON_JOB_STREAM_TIMEOUT_SEC=120
OBITAL_PRESENCE_ONLINE_WINDOW_SECONDS=180
BIN_CLEANUP_INTERVAL_SECONDS=3600
OBITAL_PROFILE_AUDIT_INTERVAL=5
OBITAL_PROFILE_AUDIT_MODEL=deepseek-chat

# Note: VERCEL is set by the hosting platform and is read to detect a
# serverless deployment. Do not set it yourself.
